{
  "name": "@frontkit-ng/signal-http-cache",
  "version": "0.3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontkit-ng/signal-http-cache.git"
  },
  "homepage": "https://github.com/frontkit-ng/signal-http-cache",
  "bugs": {
    "url": "https://github.com/frontkit-ng/signal-http-cache/issues"
  },
  "description": "Angular Signals-based HTTP caching and query state management",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest",
    "test:typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test:watch": "vitest --watch",
    "coverage": "vitest run --coverage",
    "test:compat": "node compat/scripts/run-compat.mjs --all"
  },
  "peerDependencies": {
    "@angular/core": ">=16.0.0 <23.0.0"
  },
  "devDependencies": {
    "@angular/core": "^21.0.1",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.15",
    "typescript": "^5.4.0",
    "vitest": "^4.0.15"
  },
  "keywords": [
    "angular",
    "signals",
    "http",
    "cache",
    "state",
    "query",
    "fetch"
  ],
  "license": "MIT",
  "author": "yaronshafir"
}
